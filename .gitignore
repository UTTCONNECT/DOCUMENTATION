# ==========================================================
# UTT Connect · Documentación
# Archivos temporales, de sistema, de editor y credenciales
# ==========================================================

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.stackdump

# --- Editores e IDEs ---
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# --- Microsoft Office / Word (temporales de edición) ---
~$*
*.tmp
*.temp
*.bak
*.wbk
*.asd

# --- Entornos y credenciales ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# --- Dependencias y artefactos de build ---
node_modules/
vendor/
dist/
build/
out/
coverage/
*.tsbuildinfo
.cache/

# --- Logs y volcados ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Archivos comprimidos de traspaso (no versionar entregables pesados) ---
*.zip
*.rar
*.7z
